#!/bin/bash
set -e
CFU_ROOT=$(realpath $(dirname ${BASH_SOURCE[0]})/..)
source "${CFU_ROOT}/environment"
# Prefer cfu-common python when present; fall back to system python3.
if [ -x "${CFU_ROOT}/env/conda/envs/cfu-common/bin/python" ]; then
    exec "${CFU_ROOT}/env/conda/envs/cfu-common/bin/python" "$@"
fi
exec python3 "$@"
